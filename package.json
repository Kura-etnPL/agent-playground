{
  "name": "agent-playground",
  "version": "0.1.0",
  "private": true,
  "description": "TaskFlow full-stack task management SaaS monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev --workspace @taskflow/api\" \"npm run dev --workspace @taskflow/web\"",
    "test": "npm run test --workspaces --if-present && node --test scripts/dev-orchestration.test.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
